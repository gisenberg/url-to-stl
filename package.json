{
  "name": "qr-token-studio-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/build_fontawesome_icons.mjs",
    "build:web": "npm run build:icons && node scripts/build_web.mjs",
    "test:web": "node --test web/*.test.js",
    "check:web": "node --check web/app.js && node --check web/core.js && node --check scripts/build_web.mjs && node --check scripts/build_fontawesome_icons.mjs"
  },
  "dependencies": {
    "@fortawesome/free-brands-svg-icons": "7.3.1",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "manifold-3d": "3.5.1",
    "qrcode": "1.5.4",
    "svg-pathdata": "8.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
